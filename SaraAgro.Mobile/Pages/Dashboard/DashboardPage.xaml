<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SaraAgro.Mobile.Pages.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F8FAF8, Dark=#0F1411}">

    <ContentPage.Resources>

        <!-- =========================================================
             COLORS
        ========================================================== -->

        <Color x:Key="PrimaryLight">#004C22</Color>
        <Color x:Key="PrimaryDark">#8BD79B</Color>

        <Color x:Key="BackgroundLight">#F8FAF8</Color>
        <Color x:Key="BackgroundDark">#0F1411</Color>

        <Color x:Key="CardLight">#FFFFFF</Color>
        <Color x:Key="CardDark">#18201B</Color>

        <Color x:Key="SoftLight">#EEF5EF</Color>
        <Color x:Key="SoftDark">#1E2B22</Color>

        <Color x:Key="TextLight">#141B2B</Color>
        <Color x:Key="TextDark">#F2F5F1</Color>

        <Color x:Key="SecondaryLight">#404940</Color>
        <Color x:Key="SecondaryDark">#C9D1CA</Color>

        <Color x:Key="MutedLight">#707A6F</Color>
        <Color x:Key="MutedDark">#9CA89F</Color>

        <Color x:Key="BorderLight">#D8E0D8</Color>
        <Color x:Key="BorderDark">#354239</Color>

    </ContentPage.Resources>


    <!-- =============================================================
         MAIN LAYOUT
    ============================================================= -->

    <Grid RowDefinitions="*,Auto">


        <!-- =========================================================
             CONTENT
        ========================================================== -->

        <ScrollView
            Grid.Row="0"
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="18,24,18,20"
                Spacing="0">


                <!-- =================================================
                     HEADER
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,22">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="Good Day,"
                            FontFamily="OpenSansRegular"
                            FontSize="13"
                            TextColor="{AppThemeBinding
                                Light={StaticResource SecondaryLight},
                                Dark={StaticResource SecondaryDark}}" />

                        <!-- Owner information is currently not available
                             from an API, therefore neutral placeholder -->

                        <Label
                            x:Name="OwnerNameLabel"
                            Text="—"
                            FontFamily="OpenSansSemibold"
                            FontAttributes="Bold"
                            FontSize="24"
                            TextColor="{AppThemeBinding
                                Light={StaticResource TextLight},
                                Dark={StaticResource TextDark}}" />

                        <Label
                            x:Name="DairyNameLabel"
                            Text="—"
                            FontFamily="OpenSansRegular"
                            FontSize="12"
                            TextColor="{AppThemeBinding
                                Light={StaticResource MutedLight},
                                Dark={StaticResource MutedDark}}" />

                    </VerticalStackLayout>


                    <!-- Profile -->

                    <Border
                        Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource SoftLight},
                            Dark={StaticResource SoftDark}}"
                        VerticalOptions="Start">

                        <Label
                            Text="●"
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light={StaticResource PrimaryLight},
                                Dark={StaticResource PrimaryDark}}" />

                    </Border>

                </Grid>


                <!-- =================================================
                     TODAY'S DISTRIBUTION
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,10">

                    <Label
                        Grid.Column="0"
                        Text="Today's Distribution"
                        FontFamily="OpenSansSemibold"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextLight},
                            Dark={StaticResource TextDark}}" />

                    <Label
                        Grid.Column="1"
                        x:Name="TodayDateLabel"
                        Text="Today"
                        FontSize="11"
                        VerticalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                </Grid>


                <!-- =================================================
                     MORNING / EVENING CARDS
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    Margin="0,0,0,12">


                    <!-- =================================================
                         MORNING CARD
                    ================================================== -->

                    <Border
                        Grid.Column="0"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <VerticalStackLayout Spacing="8">


                            <!-- Session -->

                            <HorizontalStackLayout Spacing="7">

                                <Border
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15"
                                    BackgroundColor="{AppThemeBinding
                                        Light={StaticResource SoftLight},
                                        Dark={StaticResource SoftDark}}">

                                    <Label
                                        Text="M"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        TextColor="{AppThemeBinding
                                            Light={StaticResource PrimaryLight},
                                            Dark={StaticResource PrimaryDark}}" />

                                </Border>

                                <Label
                                    Text="Morning"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                            </HorizontalStackLayout>


                            <!-- Cow -->

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Cow"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource SecondaryLight},
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="MorningCowLabel"
                                    Text="0.00 L"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                            </Grid>


                            <!-- Buffalo -->

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Buffalo"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource SecondaryLight},
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="MorningBuffaloLabel"
                                    Text="0.00 L"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                            </Grid>


                            <!-- Divider -->

                            <BoxView
                                HeightRequest="1"
                                Color="{AppThemeBinding
                                    Light={StaticResource BorderLight},
                                    Dark={StaticResource BorderDark}}" />


                            <!-- Total -->

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Total"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="MorningTotalLabel"
                                    Text="0.00 L"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource PrimaryLight},
                                        Dark={StaticResource PrimaryDark}}" />

                            </Grid>


                            <Label
                                x:Name="MorningAmountLabel"
                                Text="₹0.00"
                                FontSize="10"
                                TextColor="{AppThemeBinding
                                    Light={StaticResource MutedLight},
                                    Dark={StaticResource MutedDark}}" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- =================================================
                         EVENING CARD
                    ================================================== -->

                    <Border
                        Grid.Column="1"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <VerticalStackLayout Spacing="8">


                            <!-- Session -->

                            <HorizontalStackLayout Spacing="7">

                                <Border
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15"
                                    BackgroundColor="{AppThemeBinding
                                        Light=#FFF4DD,
                                        Dark=#3A301C}">

                                    <Label
                                        Text="E"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        TextColor="{AppThemeBinding
                                            Light=#8A5A00,
                                            Dark=#F3C96B}" />

                                </Border>

                                <Label
                                    Text="Evening"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                            </HorizontalStackLayout>


                            <!-- Cow -->

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Cow"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource SecondaryLight},
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="EveningCowLabel"
                                    Text="0.00 L"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                            </Grid>


                            <!-- Buffalo -->

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Buffalo"
                                    FontSize="11"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource SecondaryLight},
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="EveningBuffaloLabel"
                                    Text="0.00 L"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                            </Grid>


                            <!-- Divider -->

                            <BoxView
                                HeightRequest="1"
                                Color="{AppThemeBinding
                                    Light={StaticResource BorderLight},
                                    Dark={StaticResource BorderDark}}" />


                            <!-- Total -->

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Total"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="EveningTotalLabel"
                                    Text="0.00 L"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource PrimaryLight},
                                        Dark={StaticResource PrimaryDark}}" />

                            </Grid>


                            <Label
                                x:Name="EveningAmountLabel"
                                Text="₹0.00"
                                FontSize="10"
                                TextColor="{AppThemeBinding
                                    Light={StaticResource MutedLight},
                                    Dark={StaticResource MutedDark}}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- =================================================
                     TOTAL TODAY
                ================================================== -->

                <Border
                    Padding="16"
                    Margin="0,0,0,22"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding
                        Light={StaticResource PrimaryLight},
                        Dark={StaticResource SoftDark}}">

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="Total Today"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding
                                        Light=#D8F0DE,
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    x:Name="TotalQuantityLabel"
                                    Text="0.00 L"
                                    FontFamily="OpenSansSemibold"
                                    FontAttributes="Bold"
                                    FontSize="28"
                                    TextColor="{AppThemeBinding
                                        Light=#FFFFFF,
                                        Dark={StaticResource PrimaryDark}}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="1"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Spacing="2">

                                <Label
                                    Text="Amount"
                                    FontSize="10"
                                    HorizontalTextAlignment="End"
                                    TextColor="{AppThemeBinding
                                        Light=#D8F0DE,
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    x:Name="TotalAmountLabel"
                                    Text="₹0.00"
                                    FontFamily="OpenSansSemibold"
                                    FontAttributes="Bold"
                                    FontSize="19"
                                    HorizontalTextAlignment="End"
                                    TextColor="{AppThemeBinding
                                        Light=#FFFFFF,
                                        Dark={StaticResource PrimaryDark}}" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- Milk type totals -->

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="6">

                            <VerticalStackLayout Spacing="2">

                                <Label
                                    Text="Cow"
                                    FontSize="10"
                                    TextColor="{AppThemeBinding
                                        Light=#D8F0DE,
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    x:Name="TotalCowLabel"
                                    Text="0.00 L"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light=#FFFFFF,
                                        Dark={StaticResource PrimaryDark}}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Buffalo"
                                    FontSize="10"
                                    TextColor="{AppThemeBinding
                                        Light=#D8F0DE,
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    x:Name="TotalBuffaloLabel"
                                    Text="0.00 L"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light=#FFFFFF,
                                        Dark={StaticResource PrimaryDark}}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="2">

                                <Label
                                    Text="Customers"
                                    FontSize="10"
                                    TextColor="{AppThemeBinding
                                        Light=#D8F0DE,
                                        Dark={StaticResource SecondaryDark}}" />

                                <Label
                                    x:Name="CustomerCountLabel"
                                    Text="0"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding
                                        Light=#FFFFFF,
                                        Dark={StaticResource PrimaryDark}}" />

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     QUICK ACTIONS
                ================================================== -->

                <Label
                    Text="Quick Actions"
                    FontFamily="OpenSansSemibold"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,0,0,10"
                    TextColor="{AppThemeBinding
                        Light={StaticResource TextLight},
                        Dark={StaticResource TextDark}}" />


                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="10"
                    RowSpacing="10"
                    Margin="0,0,0,22">


                    <!-- =================================================
                         DISTRIBUTION
                    ================================================== -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="DistributionTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10">

                            <Border
                                WidthRequest="38"
                                HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="{AppThemeBinding
                                    Light={StaticResource SoftLight},
                                    Dark={StaticResource SoftDark}}">

                                <Label
                                    Text="+"
                                    FontSize="24"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource PrimaryLight},
                                        Dark={StaticResource PrimaryDark}}" />

                            </Border>

                            <VerticalStackLayout
                                VerticalOptions="Center">

                                <Label
                                    Text="Distribution"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                                <Label
                                    Text="Add milk"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>


                    <!-- =================================================
                         CUSTOMERS
                    ================================================== -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="CustomersTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10">

                            <Border
                                WidthRequest="38"
                                HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="{AppThemeBinding
                                    Light=#EEF0FF,
                                    Dark=#282D48}">

                                <Label
                                    Text="C"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light=#424E9B,
                                        Dark=#AAB4FF}" />

                            </Border>

                            <VerticalStackLayout
                                VerticalOptions="Center">

                                <Label
                                    Text="Customers"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                                <Label
                                    Text="Manage customers"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>


                    <!-- =================================================
                         RATE GROUPS
                    ================================================== -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="RateGroupsTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10">

                            <Border
                                WidthRequest="38"
                                HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="{AppThemeBinding
                                    Light={StaticResource SoftLight},
                                    Dark={StaticResource SoftDark}}">

                                <Label
                                    Text="G"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource PrimaryLight},
                                        Dark={StaticResource PrimaryDark}}" />

                            </Border>

                            <VerticalStackLayout
                                VerticalOptions="Center">

                                <Label
                                    Text="Rate Groups"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                                <Label
                                    Text="Manage groups"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>


                    <!-- =================================================
                         RATE MASTER
                    ================================================== -->

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="RatesTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10">

                            <Border
                                WidthRequest="38"
                                HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="{AppThemeBinding
                                    Light=#FFF4DD,
                                    Dark=#3A301C}">

                                <Label
                                    Text="₹"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light=#8A5A00,
                                        Dark=#F3C96B}" />

                            </Border>

                            <VerticalStackLayout
                                VerticalOptions="Center">

                                <Label
                                    Text="Rate Master"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                                <Label
                                    Text="Manage rates"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>


                    <!-- =================================================
                         BILLING
                    ================================================== -->

                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="BillingTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10">

                            <Border
                                WidthRequest="38"
                                HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="{AppThemeBinding
                                    Light=#FFF4DD,
                                    Dark=#3A301C}">

                                <Label
                                    Text="₹"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light=#8A5A00,
                                        Dark=#F3C96B}" />

                            </Border>

                            <VerticalStackLayout
                                VerticalOptions="Center">

                                <Label
                                    Text="Billing"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                                <Label
                                    Text="Bills &amp; payments"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>


                    <!-- =================================================
                         REPORTS
                    ================================================== -->

                    <Border
                        Grid.Row="2"
                        Grid.Column="1"
                        Padding="14"
                        Stroke="{AppThemeBinding
                            Light={StaticResource BorderLight},
                            Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="ReportsTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10">

                            <Border
                                WidthRequest="38"
                                HeightRequest="38"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 19"
                                BackgroundColor="{AppThemeBinding
                                    Light=#F1EAFE,
                                    Dark=#302744}">

                                <Label
                                    Text="▥"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{AppThemeBinding
                                        Light=#7650A8,
                                        Dark=#C4A8F4}" />

                            </Border>

                            <VerticalStackLayout
                                VerticalOptions="Center">

                                <Label
                                    Text="Reports"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}" />

                                <Label
                                    Text="View reports"
                                    FontSize="9"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}" />

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>


                    <!-- =================================================
                         SETTINGS
                    ================================================== -->

                    <!-- =================================================
     EXPENSES
================================================= -->

                    <Border
    Grid.Row="3"
    Grid.Column="0"
