<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SaraAgro.Mobile.Pages.RateMaster.RateMasterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F8FAF8, Dark=#0F1411}">

    <ContentPage.Resources>

        <Color x:Key="PrimaryLight">#004C22</Color>
        <Color x:Key="PrimaryDark">#8BD79B</Color>

        <Color x:Key="CardLight">#FFFFFF</Color>
        <Color x:Key="CardDark">#18201B</Color>

        <Color x:Key="InputLight">#F5F7F5</Color>
        <Color x:Key="InputDark">#202923</Color>

        <Color x:Key="TextLight">#141B2B</Color>
        <Color x:Key="TextDark">#F2F5F1</Color>

        <Color x:Key="SecondaryLight">#404940</Color>
        <Color x:Key="SecondaryDark">#C9D1CA</Color>

        <Color x:Key="MutedLight">#707A6F</Color>
        <Color x:Key="MutedDark">#9CA89F</Color>

        <Color x:Key="BorderLight">#D8E0D8</Color>
        <Color x:Key="BorderDark">#354239</Color>

    </ContentPage.Resources>


    <Grid RowDefinitions="*,Auto">


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <ScrollView
            Grid.Row="0"
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="18,20,18,110"
                Spacing="0">


                <!-- =================================================
                     HEADER
                ================================================== -->

                <Grid
                    ColumnDefinitions="48,*,48"
                    Margin="0,0,0,20">

                    <Button
                        Grid.Column="0"
                        Text="‹"
                        FontSize="32"
                        Padding="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        BackgroundColor="{AppThemeBinding
                            Light={StaticResource CardLight},
                            Dark={StaticResource CardDark}}"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextLight},
                            Dark={StaticResource TextDark}}"
                        Clicked="BackClicked" />


                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="2">

                        <Label
                            Text="Rate Master"
                            FontFamily="OpenSansSemibold"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light={StaticResource TextLight},
                                Dark={StaticResource TextDark}}" />

                        <Label
                            Text="Manage milk rates"
                            FontFamily="OpenSansRegular"
                            FontSize="10"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light={StaticResource MutedLight},
                                Dark={StaticResource MutedDark}}" />

                    </VerticalStackLayout>


                    <Button
                        Grid.Column="2"
                        Text="⋮"
                        FontSize="24"
                        Padding="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextLight},
                            Dark={StaticResource TextDark}}"
                        Clicked="MoreClicked" />

                </Grid>


                <!-- =================================================
                     FILTER
                ================================================== -->

                <Label
                    Text="Filter Rates"
                    FontFamily="OpenSansSemibold"
                    FontAttributes="Bold"
                    FontSize="15"
                    Margin="0,0,0,10"
                    TextColor="{AppThemeBinding
                        Light={StaticResource TextLight},
                        Dark={StaticResource TextDark}}" />


                <Border
                    Padding="14"
                    Margin="0,0,0,20"
                    Stroke="{AppThemeBinding
                        Light={StaticResource BorderLight},
                        Dark={StaticResource BorderDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding
                        Light={StaticResource CardLight},
                        Dark={StaticResource CardDark}}">

                    <VerticalStackLayout Spacing="12">


                        <!-- RATE GROUP -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Rate Group"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light={StaticResource SecondaryLight},
                                    Dark={StaticResource SecondaryDark}}" />

                            <Border
                                HeightRequest="50"
                                Stroke="{AppThemeBinding
                                    Light={StaticResource BorderLight},
                                    Dark={StaticResource BorderDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11"
                                BackgroundColor="{AppThemeBinding
                                    Light={StaticResource InputLight},
                                    Dark={StaticResource InputDark}}">

                                <Picker
                                    x:Name="RateGroupFilterPicker"
                                    Title="All Rate Groups"
                                    FontFamily="OpenSansRegular"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}"
                                    TitleColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}"
                                    BackgroundColor="Transparent"
                                    SelectedIndexChanged="RateGroupFilterChanged" />

                            </Border>

                        </VerticalStackLayout>


                        <!-- MILK TYPE -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Milk Type"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding
                                    Light={StaticResource SecondaryLight},
                                    Dark={StaticResource SecondaryDark}}" />

                            <Border
                                HeightRequest="50"
                                Stroke="{AppThemeBinding
                                    Light={StaticResource BorderLight},
                                    Dark={StaticResource BorderDark}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 11"
                                BackgroundColor="{AppThemeBinding
                                    Light={StaticResource InputLight},
                                    Dark={StaticResource InputDark}}">

                                <Picker
                                    x:Name="MilkTypeFilterPicker"
                                    Title="All Milk Types"
                                    FontFamily="OpenSansRegular"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding
                                        Light={StaticResource TextLight},
                                        Dark={StaticResource TextDark}}"
                                    TitleColor="{AppThemeBinding
                                        Light={StaticResource MutedLight},
                                        Dark={StaticResource MutedDark}}"
                                    BackgroundColor="Transparent"
                                    SelectedIndexChanged="MilkTypeFilterChanged" />

                            </Border>

                        </VerticalStackLayout>


                        <Button
                            Text="Clear Filters"
                            HeightRequest="36"
                            CornerRadius="10"
                            Padding="12,0"
                            HorizontalOptions="End"
                            BackgroundColor="Transparent"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding
                                Light={StaticResource PrimaryLight},
                                Dark={StaticResource PrimaryDark}}"
                            Clicked="ClearFiltersClicked" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     LIST HEADER
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,10">

                    <Label
                        Text="Milk Rates"
                        FontFamily="OpenSansSemibold"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextLight},
                            Dark={StaticResource TextDark}}" />

                    <Label
                        x:Name="RateCountLabel"
                        Grid.Column="1"
                        Text="0 rates"
                        FontSize="10"
                        VerticalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                </Grid>


                <!-- =================================================
                     EMPTY STATE
                ================================================== -->

                <Border
                    x:Name="EmptyState"
                    IsVisible="False"
                    Padding="30,35"
                    Margin="0,0,0,20"
                    Stroke="{AppThemeBinding
                        Light={StaticResource BorderLight},
                        Dark={StaticResource BorderDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding
                        Light={StaticResource CardLight},
                        Dark={StaticResource CardDark}}">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="₹"
                            FontSize="32"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light={StaticResource PrimaryLight},
                                Dark={StaticResource PrimaryDark}}" />

                        <Label
                            Text="No rates found"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light={StaticResource TextLight},
                                Dark={StaticResource TextDark}}" />

                        <Label
                            Text="Add a rate using +"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light={StaticResource MutedLight},
                                Dark={StaticResource MutedDark}}" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     RATE LIST
                ================================================== -->

                <VerticalStackLayout
                    x:Name="RateList"
                    Spacing="10" />

            </VerticalStackLayout>

        </ScrollView>


        <!-- =====================================================
             FLOATING ADD
        ====================================================== -->

        <Border
            Grid.Row="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,18"
            WidthRequest="58"
            HeightRequest="58"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 29"
            BackgroundColor="{AppThemeBinding
                Light={StaticResource PrimaryLight},
                Dark={StaticResource PrimaryDark}}">

            <Border.Shadow>
                <Shadow
                    Radius="8"
                    Opacity="0.25" />
            </Border.Shadow>

            <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="AddRateTapped" />
            </Border.GestureRecognizers>

            <Label
                Text="+"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                TextColor="{AppThemeBinding
                    Light=#FFFFFF,
                    Dark=#06210F}" />

        </Border>


        <!-- =====================================================
             BOTTOM NAV
        ====================================================== -->

        <Border
            Grid.Row="1"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding
                Light={StaticResource CardLight},
                Dark={StaticResource CardDark}}"
            Padding="4,8,4,10">

            <Grid ColumnDefinitions="*,*,*,*,*">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HomeTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="⌂"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                    <Label
                        Text="Home"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="CustomersTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="C"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                    <Label
                        Text="Customers"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="2"
                    Spacing="2"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="DistributionTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="+"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                    <Label
                        Text="Distribution"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="3"
                    Spacing="2"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ReportsTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="▥"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                    <Label
                        Text="Reports"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="4"
                    Spacing="2"
                    HorizontalOptions="Center">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingsTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="⚙"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                    <Label
                        Text="Settings"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light={StaticResource MutedLight},
                            Dark={StaticResource MutedDark}}" />

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>