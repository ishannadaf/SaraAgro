<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SaraAgro.Mobile.Pages.Expenses.ExpenseAccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Expense Accounts"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">

            <VerticalStackLayout>
                <Label Text="Expense Accounts"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#111827, Dark=White}" />

                <Label Text="Manage your expense categories"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="+ Add"
                    Clicked="AddAccountClicked"
                    BackgroundColor="{AppThemeBinding Light=#111827, Dark=#FFFFFF}"
                    TextColor="{AppThemeBinding Light=White, Dark=#111827}"
                    CornerRadius="10"
                    Padding="16,10"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Accounts -->
        <CollectionView
            x:Name="AccountCollectionView"
            Grid.Row="1"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="8">

                    <Label Text="No expense accounts"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Create your first expense category."
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Margin="0,0,0,10"
                        Padding="14"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#333333}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="4">

                            <Label
                                Text="{Binding Name}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#111827, Dark=White}" />

                            <Label
                                Grid.Row="1"
                                Text="{Binding Description}"
                                FontSize="12"
                                TextColor="Gray"
                                LineBreakMode="TailTruncation" />

                            <Label
                                Grid.Row="2"
                                Text="{Binding TotalAmount, StringFormat='Total: ₹ {0:N2}'}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#374151, Dark=#CCCCCC}" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Grid.RowSpan="3"
                                Spacing="6"
                                HorizontalOptions="End">

                                <Button
                                    Text="Edit"
                                    Clicked="EditAccountClicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    Padding="14,6"
                                    CornerRadius="8"
                                    BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#333333}"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=White}" />

                                <Button
                                    Text="Activate / Deactivate"
                                    Clicked="ToggleAccountClicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    Padding="10,6"
                                    CornerRadius="8"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Loading -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#80000000">

            <ActivityIndicator
                IsRunning="True"
                WidthRequest="45"
                HeightRequest="45"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

        </Grid>

    </Grid>

</ContentPage>