<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SaraAgro.Mobile.Pages.Customers.CustomersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F8FAF8, Dark=#0F1411}">

    <ContentPage.Resources>

        <!-- =====================================================
             THEME
        ====================================================== -->

        <Color x:Key="PrimaryLight">#004C22</Color>
        <Color x:Key="PrimaryDark">#8BD79B</Color>

        <Color x:Key="BackgroundLight">#F8FAF8</Color>
        <Color x:Key="BackgroundDark">#0F1411</Color>

        <Color x:Key="CardLight">#FFFFFF</Color>
        <Color x:Key="CardDark">#18201B</Color>

        <Color x:Key="InputLight">#F5F7F5</Color>
        <Color x:Key="InputDark">#202923</Color>

        <Color x:Key="TextLight">#141B2B</Color>
        <Color x:Key="TextDark">#F2F5F1</Color>

        <Color x:Key="SecondaryLight">#404940</Color>
        <Color x:Key="SecondaryDark">#C9D1CA</Color>

        <Color x:Key="MutedLight">#707A6F</Color>
        <Color x:Key="MutedDark">#9CA89F</Color>

        <Color x:Key="BorderLight">#D8E0D8</Color>
        <Color x:Key="BorderDark">#354239</Color>

        <Color x:Key="ActiveLight">#087A38</Color>
        <Color x:Key="ActiveDark">#8BD79B</Color>

        <Color x:Key="InactiveLight">#BA1A1A</Color>
        <Color x:Key="InactiveDark">#FFB4AB</Color>

    </ContentPage.Resources>


    <Grid RowDefinitions="*,Auto">

        <!-- =====================================================
             CONTENT
        ====================================================== -->

        <ScrollView
            Grid.Row="0"
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="18,20,18,105"
                Spacing="0">

                <!-- =================================================
                     HEADER
                ================================================== -->

                <Grid
                    ColumnDefinitions="48,*,48"
                    Margin="0,0,0,20">

                    <Button
                        Grid.Column="0"
                        Text="‹"
                        FontSize="32"
                        Padding="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        BackgroundColor="{AppThemeBinding
                            Light=#FFFFFF,
                            Dark=#18201B}"
                        TextColor="{AppThemeBinding
                            Light=#141B2B,
                            Dark=#F2F5F1}"
                        Clicked="BackClicked" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="2">

                        <Label
                            Text="Customers"
                            FontFamily="OpenSansSemibold"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light=#141B2B,
                                Dark=#F2F5F1}" />

                        <Label
                            Text="Manage your customers"
                            FontSize="10"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light=#707A6F,
                                Dark=#9CA89F}" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="⋮"
                        FontSize="24"
                        Padding="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding
                            Light=#141B2B,
                            Dark=#F2F5F1}"
                        Clicked="MoreClicked" />

                </Grid>


                <!-- =================================================
                     SEARCH
                ================================================== -->

                <Border
                    HeightRequest="52"
                    Margin="0,0,0,12"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 13"
                    BackgroundColor="{AppThemeBinding
                        Light=#F5F7F5,
                        Dark=#202923}">

                    <Grid ColumnDefinitions="38,*">

                        <Label
                            Grid.Column="0"
                            Text="⌕"
                            FontSize="25"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light=#707A6F,
                                Dark=#9CA89F}" />

                        <Entry
                            x:Name="SearchEntry"
                            Grid.Column="1"
                            Placeholder="Search name, code or mobile"
                            PlaceholderColor="{AppThemeBinding
                                Light=#707A6F,
                                Dark=#9CA89F}"
                            FontSize="13"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding
                                Light=#141B2B,
                                Dark=#F2F5F1}"
                            TextChanged="SearchTextChanged" />

                    </Grid>

                </Border>


                <!-- =================================================
                     FILTERS
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    Margin="0,0,0,20">

                    <!-- Route -->

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="4">

                        <Label
                            Text="Route / Area"
                            FontAttributes="Bold"
                            FontSize="10"
                            TextColor="{AppThemeBinding
                                Light=#404940,
                                Dark=#C9D1CA}" />

                        <Border
                            HeightRequest="47"
                            Stroke="{AppThemeBinding
                                Light=#D8E0D8,
                                Dark=#354239}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 11"
                            BackgroundColor="{AppThemeBinding
                                Light=#FFFFFF,
                                Dark=#18201B}">

                            <Picker
                                x:Name="RouteFilterPicker"
                                Title="All Routes"
                                FontSize="12"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding
                                    Light=#141B2B,
                                    Dark=#F2F5F1}"
                                TitleColor="{AppThemeBinding
                                    Light=#707A6F,
                                    Dark=#9CA89F}"
                                SelectedIndexChanged="RouteFilterChanged" />

                        </Border>

                    </VerticalStackLayout>


                    <!-- Milk Type -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4">

                        <Label
                            Text="Milk Type"
                            FontAttributes="Bold"
                            FontSize="10"
                            TextColor="{AppThemeBinding
                                Light=#404940,
                                Dark=#C9D1CA}" />

                        <Border
                            HeightRequest="47"
                            Stroke="{AppThemeBinding
                                Light=#D8E0D8,
                                Dark=#354239}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 11"
                            BackgroundColor="{AppThemeBinding
                                Light=#FFFFFF,
                                Dark=#18201B}">

                            <Picker
                                x:Name="MilkTypeFilterPicker"
                                Title="All Types"
                                FontSize="12"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding
                                    Light=#141B2B,
                                    Dark=#F2F5F1}"
                                TitleColor="{AppThemeBinding
                                    Light=#707A6F,
                                    Dark=#9CA89F}"
                                SelectedIndexChanged="MilkTypeFilterChanged" />

                        </Border>

                    </VerticalStackLayout>

                </Grid>


                <!-- =================================================
                     CUSTOMER HEADER
                ================================================== -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,10">

                    <Label
                        Text="Customers"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="{AppThemeBinding
                            Light=#141B2B,
                            Dark=#F2F5F1}" />

                    <Label
                        x:Name="CustomerCountLabel"
                        Grid.Column="1"
                        Text="0 customers"
                        FontSize="10"
                        VerticalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                </Grid>


                <!-- =================================================
                     EMPTY STATE
                ================================================== -->

                <Border
                    x:Name="EmptyState"
                    IsVisible="False"
                    Padding="30,35"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="C"
                            FontSize="32"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light=#004C22,
                                Dark=#8BD79B}" />

                        <Label
                            Text="No customers found"
                            FontAttributes="Bold"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light=#141B2B,
                                Dark=#F2F5F1}" />

                        <Label
                            Text="Try changing your search or filters."
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding
                                Light=#707A6F,
                                Dark=#9CA89F}" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     CUSTOMER LIST
                ================================================== -->

                <VerticalStackLayout
                    x:Name="CustomerList"
                    Spacing="10" />

            </VerticalStackLayout>

        </ScrollView>


        <!-- =====================================================
             FLOATING ADD
        ====================================================== -->

        <Border
            Grid.Row="0"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,18"
            WidthRequest="58"
            HeightRequest="58"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 29"
            BackgroundColor="{AppThemeBinding
                Light=#004C22,
                Dark=#8BD79B}">

            <Border.Shadow>
                <Shadow
                    Radius="8"
                    Opacity="0.25" />
            </Border.Shadow>

            <Border.GestureRecognizers>

                <TapGestureRecognizer
                    Tapped="AddCustomerTapped" />

            </Border.GestureRecognizers>

            <Label
                Text="+"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                TextColor="{AppThemeBinding
                    Light=#FFFFFF,
                    Dark=#06210F}" />

        </Border>


        <!-- =====================================================
             BOTTOM NAVIGATION
        ====================================================== -->

        <Border
            Grid.Row="1"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding
                Light=#FFFFFF,
                Dark=#18201B}"
            Padding="4,8,4,10">

            <Grid ColumnDefinitions="*,*,*,*,*">

                <VerticalStackLayout
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="HomeTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="⌂"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                    <Label
                        Text="Home"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="C"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#004C22,
                            Dark=#8BD79B}" />

                    <Label
                        Text="Customers"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#004C22,
                            Dark=#8BD79B}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="2"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="DistributionTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Label
                        Text="+"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                    <Label
                        Text="Distribution"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="3"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="▥"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                    <Label
                        Text="Reports"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                </VerticalStackLayout>


                <VerticalStackLayout
                    Grid.Column="4"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="⚙"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                    <Label
                        Text="Settings"
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding
                            Light=#707A6F,
                            Dark=#9CA89F}" />

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>