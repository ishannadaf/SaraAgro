<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SaraAgro.Mobile.Pages.Reports.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reports">

    <ContentPage.Resources>

        <!-- =====================================================
             COMMON STYLES
        ====================================================== -->

        <Style TargetType="Label">
            <Setter
                Property="TextColor"
                Value="{AppThemeBinding
                    Light=#141B2B,
                    Dark=#F2F5F1}" />
        </Style>

        <Style TargetType="Entry">
            <Setter
                Property="TextColor"
                Value="{AppThemeBinding
                    Light=#141B2B,
                    Dark=#F2F5F1}" />

            <Setter
                Property="PlaceholderColor"
                Value="{AppThemeBinding
                    Light=#7A827D,
                    Dark=#89958D}" />

            <Setter
                Property="BackgroundColor"
                Value="Transparent" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter
                Property="TextColor"
                Value="{AppThemeBinding
                    Light=#141B2B,
                    Dark=#F2F5F1}" />

            <Setter
                Property="BackgroundColor"
                Value="Transparent" />
        </Style>

        <Style TargetType="Button">
            <Setter
                Property="FontAttributes"
                Value="Bold" />

            <Setter
                Property="CornerRadius"
                Value="10" />
        </Style>

    </ContentPage.Resources>


    <!-- =========================================================
         PAGE
    ========================================================== -->

    <Grid
        RowDefinitions="Auto,*"
        BackgroundColor="{AppThemeBinding
            Light=#F8FAF8,
            Dark=#0F1411}">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <Grid
            Grid.Row="0"
            Padding="18,14"
            ColumnDefinitions="Auto,*,Auto">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="32"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding
                    Light=#141B2B,
                    Dark=#F2F5F1}"
                Clicked="BackClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="1"
                VerticalOptions="Center">

                <Label
                    Text="Reports"
                    FontSize="21"
                    FontAttributes="Bold" />

                <Label
                    Text="Dairy business reports"
                    FontSize="11"
                    Opacity="0.65" />

            </VerticalStackLayout>

        </Grid>


        <!-- =====================================================
             MAIN SCROLL
        ====================================================== -->

        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="16,0,16,30"
                Spacing="14">


                <!-- =================================================
                     CUSTOMER LEDGER
                ================================================== -->

                <Border
                    Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="10">


                        <Label
                            Text="Customer Ledger"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            Text="View customer transactions for a date range"
                            FontSize="11"
                            Opacity="0.65" />


                        <!-- CUSTOMER SEARCH -->

                        <Border
                            Padding="10,2"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding
                                Light=#D8E0D8,
                                Dark=#354239}"
                            BackgroundColor="{AppThemeBinding
                                Light=#F8FAF8,
                                Dark=#111712}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="CustomerSearchEntry"
                                Placeholder="Search customer code, name or mobile"
                                TextChanged="CustomerSearchTextChanged" />

                        </Border>


                        <!-- SEARCH RESULTS -->

                        <VerticalStackLayout
                            x:Name="CustomerSearchResults"
                            IsVisible="False"
                            Spacing="2"
                            BackgroundColor="{AppThemeBinding
                                Light=#F8FAF8,
                                Dark=#111712}" />


                        <!-- SELECTED CUSTOMER -->

                        <Border
                            x:Name="SelectedCustomerCard"
                            IsVisible="False"
                            Padding="10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding
                                Light=#B7DCC1,
                                Dark=#355C40}"
                            BackgroundColor="{AppThemeBinding
                                Light=#EEF8F0,
                                Dark=#17261B}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="*,Auto">

                                <VerticalStackLayout
                                    Spacing="2">

                                    <Label
                                        x:Name="SelectedCustomerCodeLabel"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="SelectedCustomerNameLabel"
                                        FontSize="14"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="×"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    FontSize="20"
                                    BackgroundColor="Transparent"
                                    Clicked="ClearCustomerClicked" />

                            </Grid>

                        </Border>


                        <!-- DATE RANGE -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="From"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    Opacity="0.65" />

                                <Border
                                    Padding="6,0"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding
                                        Light=#D8E0D8,
                                        Dark=#354239}">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <DatePicker
                                        x:Name="FromDatePicker"
                                        Format="dd MMM yyyy" />

                                </Border>

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3">

                                <Label
                                    Text="To"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    Opacity="0.65" />

                                <Border
                                    Padding="6,0"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding
                                        Light=#D8E0D8,
                                        Dark=#354239}">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <DatePicker
                                        x:Name="ToDatePicker"
                                        Format="dd MMM yyyy" />

                                </Border>

                            </VerticalStackLayout>

                        </Grid>


                        <Button
                            x:Name="CustomerLedgerButton"
                            Text="Generate Ledger"
                            HeightRequest="44"
                            BackgroundColor="{AppThemeBinding
                                Light=#004C22,
                                Dark=#8BD79B}"
                            TextColor="{AppThemeBinding
                                Light=#FFFFFF,
                                Dark=#06210F}"
                            Clicked="CustomerLedgerClicked" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     DAILY REPORT
                ================================================== -->

                <Border
                    Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="Daily Report"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            Text="Complete milk distribution for one day"
                            FontSize="11"
                            Opacity="0.65" />

                        <Border
                            Padding="6,0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding
                                Light=#D8E0D8,
                                Dark=#354239}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <DatePicker
                                x:Name="DailyDatePicker"
                                Format="dd MMM yyyy" />

                        </Border>

                        <Button
                            x:Name="DailyReportButton"
                            Text="View Daily Report"
                            HeightRequest="44"
                            BackgroundColor="{AppThemeBinding
                                Light=#004C22,
                                Dark=#8BD79B}"
                            TextColor="{AppThemeBinding
                                Light=#FFFFFF,
                                Dark=#06210F}"
                            Clicked="DailyReportClicked" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     MONTHLY REPORT
                ================================================== -->

                <Border
                    Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="Monthly Report"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            Text="Monthly milk and customer summary"
                            FontSize="11"
                            Opacity="0.65" />

                        <Border
                            Padding="6,0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding
                                Light=#D8E0D8,
                                Dark=#354239}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <DatePicker
                                x:Name="MonthlyDatePicker"
                                Format="MMMM yyyy" />

                        </Border>

                        <Button
                            x:Name="MonthlyReportButton"
                            Text="View Monthly Report"
                            HeightRequest="44"
                            BackgroundColor="{AppThemeBinding
                                Light=#004C22,
                                Dark=#8BD79B}"
                            TextColor="{AppThemeBinding
                                Light=#FFFFFF,
                                Dark=#06210F}"
                            Clicked="MonthlyReportClicked" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     PENDING AMOUNT
                ================================================== -->

                <Border
                    Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="Pending Amount"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            Text="Customers with outstanding balance"
                            FontSize="11"
                            Opacity="0.65" />

                        <Border
                            Padding="6,0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding
                                Light=#D8E0D8,
                                Dark=#354239}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <DatePicker
                                x:Name="PendingDatePicker"
                                Format="dd MMM yyyy" />

                        </Border>

                        <Button
                            x:Name="PendingReportButton"
                            Text="View Pending Amount"
                            HeightRequest="44"
                            BackgroundColor="{AppThemeBinding
                                Light=#8A5A00,
                                Dark=#D7A84D}"
                            TextColor="{AppThemeBinding
                                Light=#FFFFFF,
                                Dark=#211500}"
                            Clicked="PendingReportClicked" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     ALL PAYMENTS
                ================================================== -->

                <Border
                    Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="All Payments"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            Text="View all customer payments for a date range"
                            FontSize="11"
                            Opacity="0.65" />


                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="From"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    Opacity="0.65" />

                                <Border
                                    Padding="6,0"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding
                                        Light=#D8E0D8,
                                        Dark=#354239}">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <DatePicker
                                        x:Name="PaymentsFromDatePicker"
                                        Format="dd MMM yyyy" />

                                </Border>

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3">

                                <Label
                                    Text="To"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    Opacity="0.65" />

                                <Border
                                    Padding="6,0"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding
                                        Light=#D8E0D8,
                                        Dark=#354239}">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <DatePicker
                                        x:Name="PaymentsToDatePicker"
                                        Format="dd MMM yyyy" />

                                </Border>

                            </VerticalStackLayout>

                        </Grid>


                        <Button
                            x:Name="PaymentsReportButton"
                            Text="View All Payments"
                            HeightRequest="44"
                            BackgroundColor="{AppThemeBinding
                                Light=#004C22,
                                Dark=#8BD79B}"
                            TextColor="{AppThemeBinding
                                Light=#FFFFFF,
                                Dark=#06210F}"
                            Clicked="PaymentsReportClicked" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     EMPTY RESULT
                ================================================== -->

                <VerticalStackLayout
                    x:Name="EmptyResult"
                    IsVisible="False"
                    Padding="20"
                    Spacing="5"
                    HorizontalOptions="Center">

                    <Label
                        x:Name="EmptyResultLabel"
                        Text="No report data found."
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- =================================================
                     CUSTOMER LEDGER RESULT
                ================================================== -->

                <Border
                    x:Name="CustomerLedgerResult"
                    IsVisible="False"
                    Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="Customer Ledger"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="CustomerLedgerTitleLabel"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="CustomerLedgerPeriodLabel"
                            FontSize="11"
                            Opacity="0.65" />


                        <!-- SUMMARY -->

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="8">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#EEF2FF,
                                    Dark=#1D2540}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout
                                    Spacing="2">

                                    <Label
                                        Text="Opening"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="LedgerOpeningLabel"
                                        Text="₹0.00"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#E6F4EA,
                                    Dark=#193522}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout
                                    Spacing="2">

                                    <Label
                                        Text="Milk"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="LedgerMilkQuantityLabel"
                                        Text="0.00 L"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#FFF4DE,
                                    Dark=#3A2F18}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout
                                    Spacing="2">

                                    <Label
                                        Text="Milk Amount"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="LedgerMilkAmountLabel"
                                        Text="₹0.00"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#E6F4EA,
                                    Dark=#193522}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout
                                    Spacing="2">

                                    <Label
                                        Text="Payments"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="LedgerPaymentsLabel"
                                        Text="₹0.00"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Padding="12"
                                BackgroundColor="{AppThemeBinding
                                    Light=#193522,
                                    Dark=#193522}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid
                                    ColumnDefinitions="*,Auto">

                                    <Label
                                        Text="Closing Balance"
                                        FontSize="13"
                                        TextColor="White"
                                        FontAttributes="Bold" />

                                    <Label
                                        Grid.Column="1"
                                        x:Name="LedgerClosingLabel"
                                        Text="₹0.00"
                                        FontSize="17"
                                        TextColor="White"
                                        FontAttributes="Bold" />

                                </Grid>

                            </Border>

                        </Grid>


                        <Label
                            Text="Transactions"
                            FontSize="14"
                            FontAttributes="Bold"
                            Margin="0,5,0,0" />


                        <Label
                            x:Name="CustomerLedgerEmptyLabel"
                            Text="No transactions found."
                            IsVisible="False"
                            FontSize="12"
                            Opacity="0.65"
                            HorizontalTextAlignment="Center" />


                        <VerticalStackLayout
                            x:Name="CustomerLedgerList"
                            Spacing="8" />

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     DAILY RESULT
                ================================================== -->

                <Border
                    x:Name="DailyReportResult"
                    IsVisible="False"
                    Padding="14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding
                        Light=#D8E0D8,
                        Dark=#354239}"
                    BackgroundColor="{AppThemeBinding
                        Light=#FFFFFF,
                        Dark=#18201B}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="Daily Report"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="DailyReportTitleLabel"
                            FontSize="12"
                            Opacity="0.65" />


                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="8">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#E6F4EA,
                                    Dark=#193522}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout>

                                    <Label
                                        Text="Cow"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="DailyCowLabel"
                                        Text="0.00 L"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#EEF2FF,
                                    Dark=#1D2540}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout>

                                    <Label
                                        Text="Buffalo"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="DailyBuffaloLabel"
                                        Text="0.00 L"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#FFF4DE,
                                    Dark=#3A2F18}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout>

                                    <Label
                                        Text="Total Milk"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="DailyTotalQuantityLabel"
                                        Text="0.00 L"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#E6F4EA,
                                    Dark=#193522}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout>

                                    <Label
                                        Text="Amount"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="DailyTotalAmountLabel"
                                        Text="₹0.00"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#F1F3F2,
                                    Dark=#202722}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout>

                                    <Label
                                        Text="Customers"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="DailyCustomerCountLabel"
                                        Text="0"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                </VerticalStackLayout>

                            </Border>


                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                Padding="10"
                                BackgroundColor="{AppThemeBinding
                                    Light=#F1F3F2,
                                    Dark=#202722}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout>

                                    <Label
                                        Text="Morning"
                                        FontSize="10"
                                        Opacity="0.7" />

                                    <Label
                                        x:Name="DailyMorningLabel"
                                        Text="0.00 L"
                                        FontSize="15"
                                        FontAttributes="Bold" />

                                    <Label
                                        x:Name="DailyMorningAmountLabel"
                                        Text="₹0.00"
                                        FontSize="10"
                                        Opacity="0.7" />

                                </VerticalStackLayout>

                            </Border>

                        </Grid>


                        <Grid
                            ColumnDefinitions="*,Auto"
                            Margin="0,2,0,0">

                            <Label
                                Text="Evening"
                                FontSize="12"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Column="1"
                                x:Name="DailyEveningLabel"
                                Text="0.00 L"
                                FontSize="12"
                                FontAttributes="Bold" />

                        </Grid>

                        <Label
                            x:Name="DailyEveningAmountLabel"
                            Text="₹0.00"
                            FontSize="10"
