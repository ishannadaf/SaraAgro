<?xml version="1.0" encoding="UTF-8" ?>

<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SaraAgro.Mobile"
    x:Class="SaraAgro.Mobile.App">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="Resources/Styles/Colors.xaml" />

                <ResourceDictionary
                    Source="Resources/Styles/Styles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- Report page dynamic resources -->
            <Color
                x:Key="PrimaryTextColor">
                #1C1C1C
            </Color>

            <Color
                x:Key="SecondaryTextColor">
                #666666
            </Color>

            <Color
                x:Key="CardBackgroundColor">
                #FFFFFF
            </Color>

            <Color
                x:Key="BorderColor">
                #DDDDDD
            </Color>

        </ResourceDictionary>

    </Application.Resources>

</Application>